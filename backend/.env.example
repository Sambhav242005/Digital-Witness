FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=backend/data
# Keep this only in a backend environment file; never in NEXT_PUBLIC_*:
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_VERIFICATION_MODEL=gemini-3.5-flash
# Hugging Face downloads this local multimodal model on startup if not cached.
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=google/embeddinggemma-2
HF_EMBEDDING_REVISION=914f7f89142e33e77833254d9c9b90c3cef7303b
HF_AUTO_DOWNLOAD_EMBEDDING=true
# Optional alternative embedding provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
CHAT_PROVIDER=ollama
CHAT_BASE_URL=http://localhost:11434/v1
CHAT_API_KEY=ollama
CHAT_MODEL=gemma4:31b-cloud
LOAD_MODELS=true
MAX_QUEUED_JOBS=20
# Set only after validation on your development footage:
# RELEVANCE_THRESHOLD=...
VERIFICATION_YES_THRESHOLD=0.8
VERIFICATION_NO_THRESHOLD=0.2
